# Se omitido, o projeto carrega POSTGRES_URI de ../social_data_pipeline/.env.
# POSTGRES_URI=postgresql://radar:change_me@localhost:5433/radar_odio

OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=gemma3:4b
# Alternativa sem Ollama: INFERENCE_BACKEND=huggingface
# HF_MODEL=google/gemma-3-4b-it
# HF_TOKEN=cole_seu_token_da_hugging_face (necessário se o acesso ao Gemma não estiver liberado)
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_MAX_RETRIES=3
OLLAMA_RETRY_DELAY_SECONDS=5
OLLAMA_NUM_CTX=2304
OLLAMA_NUM_PREDICT=300
OLLAMA_DETAIL_NUM_PREDICT=512
# Offload máximo validado na GTX 1650 de 4 GB. Use 0 somente para forçar CPU.
OLLAMA_NUM_GPU=999

PROMPT_VERSION=gemma3_4b_structured_v2
MAX_TEXT_CHARS=1800
DATABASE_BATCH_SIZE=25
INFERENCE_BATCH_SIZE=16
# Soma máxima dos caracteres dos textos em uma chamada, protegendo o contexto.
INFERENCE_BATCH_MAX_CHARS=3600
MAX_CONSECUTIVE_ERRORS=25
